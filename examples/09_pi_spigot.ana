.fn calculate_pi_digits(p0: ptr, p1: i64) -> i64
    .registers 12 local

    ; p0 = memory pointer for state array (allocated buffer)
    ; p1 = number of digits N to calculate
    ; Returns checksum of calculated Pi digits

    ; v0 = len = (p1 * 10) / 3 + 1
    move-const v0, 10
    mul-int/64 v0, p1, v0
    move-const v1, 3
    div-int/64 v0, v0, v1
    add-int/64 v0, v0, 1

    ; 1. Initialize array a[i] = 2 for i = 0..len-1
    move-const v1, 0
init_loop:
    if-ge v1, v0, init_end
    move-const v2, 2
    move-const v3, 8
    mul-int/64 v3, v1, v3
    add-int/64 v4, p0, v3
    store-mem [v4 + 0], v2
    add-int/64 v1, v1, 1
    goto init_loop
init_end:

    move-const v5, 0      ; v5 = digit_count
    move-const v6, 0      ; v6 = checksum_sum

digit_loop:
    if-ge v5, p1, digit_end

    move-const v7, 0      ; v7 = q (carry)
    sub-int/64 v1, v0, 1  ; v1 = i (starting at len - 1)

inner_loop:
    if-lt v1, 0, inner_end

    ; load a[i]
    move-const v3, 8
    mul-int/64 v3, v1, v3
    add-int/64 v4, p0, v3
    load-mem v8, [v4 + 0] ; v8 = a[i]

    ; x = 10 * a[i]
    move-const v9, 10
    mul-int/64 v8, v8, v9

    if-eq v1, 0, i_zero
    mul-int/64 v10, v7, v1
    add-int/64 v8, v8, v10
    move-const v9, 2
    mul-int/64 v9, v1, v9
    add-int/64 v9, v9, 1
    goto i_done

i_zero:
    add-int/64 v8, v8, v7
    move-const v9, 10

i_done:
    ; q = x / denom
    div-int/64 v7, v8, v9

    ; a[i] = x % denom = x - q * denom
    mul-int/64 v10, v7, v9
    sub-int/64 v8, v8, v10
    store-mem [v4 + 0], v8

    sub-int/64 v1, v1, 1
    goto inner_loop

inner_end:
    ; v7 is calculated digit candidate
    add-int/64 v6, v6, v7
    add-int/64 v5, v5, 1
    goto digit_loop

digit_end:
    return-val v6
.end_fn
