.fn esp32s3_hello_world(p0: i64) -> i64
    .registers 6 local

    ; 1. Unlock & Disable ESP32-S3 Timer Group 0 Watchdog (TIMG0 WDT)
    ; Magic write protection key: 0x50D83AA1 = 1356348065
    move-const v0, 1610739812     ; 0x6001F064 = TIMG0_WDTWPROTECT_REG
    move-const v1, 1356348065     ; 0x50D83AA1 = TIMG_WDT_WKEY
    store-mem [v0 + 0], v1
    move-const v0, 1610739784     ; 0x6001F048 = TIMG0_WDTCONFIG0_REG
    move-const v1, 0              ; 0 = Disable Watchdog
    store-mem [v0 + 0], v1
    move-const v0, 1610739808     ; 0x6001F060 = TIMG0_WDTFEED_REG
    move-const v1, 1              ; 1 = Feed Watchdog
    store-mem [v0 + 0], v1

    ; 2. Unlock & Disable RTC Watchdog (RTC WDT)
    move-const v0, 1610645668     ; 0x600080A4 = RTC_CNTL_WDTWPROTECT_REG
    move-const v1, 1356348065     ; 0x50D83AA1 = RTC_WDT_WKEY
    store-mem [v0 + 0], v1
    move-const v0, 1610645656     ; 0x60008098 = RTC_CNTL_WDTCONFIG0_REG
    move-const v1, 0              ; 0 = Disable RTC Watchdog
    store-mem [v0 + 0], v1
    move-const v0, 1610645664     ; 0x600080A0 = RTC_CNTL_WDTFEED_REG
    move-const v1, 1              ; 1 = Feed RTC Watchdog
    store-mem [v0 + 0], v1

    ; 3. Configure GPIOs for Discrete RGB + WS2812
    ; Enable GPIO 48 (bit 16), GPIO 47 (bit 15), GPIO 38 (bit 6)
    ; Mask = 65536 + 32768 + 64 = 98368
    move-const v0, 1610629164     ; 0x6000402C = GPIO_ENABLE1_W1TS_REG
    move-const v1, 98368
    store-mem [v0 + 0], v1

    ; Enable GPIO 21 (bit 21 = 2097152)
    move-const v0, 1610629156     ; 0x60004024 = GPIO_ENABLE_W1TS_REG
    move-const v1, 2097152
    store-mem [v0 + 0], v1

    ; Discrete LED mode: Set GPIO 47 (Green) HIGH, Set GPIO 48 (Blue) & GPIO 21 (Red) LOW
    move-const v0, 1610629140     ; 0x60004014 = GPIO_OUT1_W1TS_REG (Set HIGH)
    move-const v1, 32768          ; GPIO 47 HIGH (Green)
    store-mem [v0 + 0], v1

    move-const v0, 1610629144     ; 0x60004018 = GPIO_OUT1_W1TC_REG (Clear LOW)
    move-const v1, 65536          ; GPIO 48 LOW (Blue)
    store-mem [v0 + 0], v1

    move-const v0, 1610629136     ; 0x60004010 = GPIO_OUT_W1TC_REG (Clear LOW)
    move-const v1, 2097152        ; GPIO 21 LOW (Red)
    store-mem [v0 + 0], v1

    ; 4. WS2812 Timing Generation for GPIO 48 & GPIO 38
    move-const v0, 1610629140     ; Set HIGH reg
    move-const v3, 1610629144     ; Clear LOW reg
    move-const v4, 65600          ; GPIO 48 | GPIO 38

    ; Latch Reset (Hold LOW)
    store-mem [v3 + 0], v4
    store-mem [v3 + 0], v4
    store-mem [v3 + 0], v4

    ; Send 8 bits of '1's for GREEN channel (Green = 0x20 / 0xFF)
    store-mem [v0 + 0], v4
    move-const v5, 1
    move-const v5, 2
    store-mem [v3 + 0], v4

    store-mem [v0 + 0], v4
    move-const v5, 1
    move-const v5, 2
    store-mem [v3 + 0], v4

    store-mem [v0 + 0], v4
    move-const v5, 1
    move-const v5, 2
    store-mem [v3 + 0], v4

    store-mem [v0 + 0], v4
    move-const v5, 1
    move-const v5, 2
    store-mem [v3 + 0], v4

    store-mem [v0 + 0], v4
    move-const v5, 1
    move-const v5, 2
    store-mem [v3 + 0], v4

    store-mem [v0 + 0], v4
    move-const v5, 1
    move-const v5, 2
    store-mem [v3 + 0], v4

    store-mem [v0 + 0], v4
    move-const v5, 1
    move-const v5, 2
    store-mem [v3 + 0], v4

    store-mem [v0 + 0], v4
    move-const v5, 1
    move-const v5, 2
    store-mem [v3 + 0], v4

    ; Send 16 bits of '0's for RED & BLUE channels (0x00)
    ; For bit '0': immediate LOW then delay
    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    store-mem [v0 + 0], v4
    store-mem [v3 + 0], v4
    move-const v5, 1
    move-const v5, 2
    move-const v5, 3

    ; Latch Reset (Hold LOW)
    store-mem [v3 + 0], v4

    ; 5. Stream "Hello World from Anastasia on ESP32-S3!\r\n"
    move-const v0, 1610612736     ; 0x60000000 = UART0 FIFO
    move-const v2, 1610887168     ; 0x60043000 = USB-Serial-JTAG FIFO

    move-const v1, 72             ; 'H'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 101            ; 'e'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 108            ; 'l'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 108            ; 'l'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 111            ; 'o'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 87             ; 'W'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 111            ; 'o'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 114            ; 'r'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 108            ; 'l'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 100            ; 'd'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 102            ; 'f'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 114            ; 'r'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 111            ; 'o'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 109            ; 'm'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 65             ; 'A'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 110            ; 'n'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 97             ; 'a'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 115            ; 's'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 116            ; 't'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 97             ; 'a'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 115            ; 's'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 105            ; 'i'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 97             ; 'a'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 111            ; 'o'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 110            ; 'n'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 69             ; 'E'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 83             ; 'S'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 80             ; 'P'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 51             ; '3'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 52             ; '2'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 45             ; '-'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 83             ; 'S'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 51             ; '3'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 33             ; '!'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 13             ; '\r'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1
    move-const v1, 10             ; '\n'
    store-mem [v0 + 0], v1
    store-mem [v2 + 0], v1

    ; Flush USB-Serial-JTAG buffer to PC host
    move-const v0, 1610887172     ; 0x60043004 = USB_SERIAL_JTAG_EP1_CONF_REG
    move-const v1, 1              ; Flush packet
    store-mem [v0 + 0], v1

    ; 6. Bare-metal park loop: Continuously feed watchdog in a loop
park_loop:
    move-const v0, 1610739808     ; 0x6001F060 = TIMG0_WDTFEED_REG
    move-const v1, 1              ; 1 = Feed Watchdog
    store-mem [v0 + 0], v1
    goto park_loop

    move-const v2, 1
    return-val v2
.end_fn
