.fn esp32s3_hello_world(p0: i64) -> i64
    .registers 6 local

    ; 1. Unlock & Disable ESP32-S3 Timer Group 0 Watchdog (TIMG0 WDT)
    ; Magic write protection key: 0x50D83AA1 = 1356348065
    move-const v0, 1610739812     ; 0x6001F064 = TIMG0_WDTWPROTECT_REG
    move-const v1, 1356348065     ; 0x50D83AA1 = TIMG_WDT_WKEY
    store-mem [v0 + 0], v1
    move-const v0, 1610739784     ; 0x6001F048 = TIMG0_WDTCONFIG0_REG
    move-const v1, 0              ; 0 = Disable Watchdog
    store-mem [v0 + 0], v1

    ; 2. Unlock & Disable RTC Watchdog (RTC WDT)
    move-const v0, 1610645668     ; 0x600080A4 = RTC_CNTL_WDTWPROTECT_REG
    move-const v1, 1356348065     ; 0x50D83AA1 = RTC_WDT_WKEY
    store-mem [v0 + 0], v1
    move-const v0, 1610645656     ; 0x60008098 = RTC_CNTL_WDTCONFIG0_REG
    move-const v1, 0              ; 0 = Disable RTC Watchdog
    store-mem [v0 + 0], v1

    ; 3. Stream "Hello World from Anastasia on ESP32-S3!\r\n" to UART0 FIFO (0x60000000)
    move-const v0, 1610612736     ; 0x60000000 = UART0 FIFO
    move-const v1, 72             ; 'H'
    store-mem [v0 + 0], v1
    move-const v1, 101            ; 'e'
    store-mem [v0 + 0], v1
    move-const v1, 108            ; 'l'
    store-mem [v0 + 0], v1
    move-const v1, 108            ; 'l'
    store-mem [v0 + 0], v1
    move-const v1, 111            ; 'o'
    store-mem [v0 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    move-const v1, 87             ; 'W'
    store-mem [v0 + 0], v1
    move-const v1, 111            ; 'o'
    store-mem [v0 + 0], v1
    move-const v1, 114            ; 'r'
    store-mem [v0 + 0], v1
    move-const v1, 108            ; 'l'
    store-mem [v0 + 0], v1
    move-const v1, 100            ; 'd'
    store-mem [v0 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    move-const v1, 102            ; 'f'
    store-mem [v0 + 0], v1
    move-const v1, 114            ; 'r'
    store-mem [v0 + 0], v1
    move-const v1, 111            ; 'o'
    store-mem [v0 + 0], v1
    move-const v1, 109            ; 'm'
    store-mem [v0 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    move-const v1, 65             ; 'A'
    store-mem [v0 + 0], v1
    move-const v1, 110            ; 'n'
    store-mem [v0 + 0], v1
    move-const v1, 97             ; 'a'
    store-mem [v0 + 0], v1
    move-const v1, 115            ; 's'
    store-mem [v0 + 0], v1
    move-const v1, 116            ; 't'
    store-mem [v0 + 0], v1
    move-const v1, 97             ; 'a'
    store-mem [v0 + 0], v1
    move-const v1, 115            ; 's'
    store-mem [v0 + 0], v1
    move-const v1, 105            ; 'i'
    store-mem [v0 + 0], v1
    move-const v1, 97             ; 'a'
    store-mem [v0 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    move-const v1, 111            ; 'o'
    store-mem [v0 + 0], v1
    move-const v1, 110            ; 'n'
    store-mem [v0 + 0], v1
    move-const v1, 32             ; ' '
    store-mem [v0 + 0], v1
    move-const v1, 69             ; 'E'
    store-mem [v0 + 0], v1
    move-const v1, 83             ; 'S'
    store-mem [v0 + 0], v1
    move-const v1, 80             ; 'P'
    store-mem [v0 + 0], v1
    move-const v1, 51             ; '3'
    store-mem [v0 + 0], v1
    move-const v1, 52             ; '2'
    store-mem [v0 + 0], v1
    move-const v1, 45             ; '-'
    store-mem [v0 + 0], v1
    move-const v1, 83             ; 'S'
    store-mem [v0 + 0], v1
    move-const v1, 51             ; '3'
    store-mem [v0 + 0], v1
    move-const v1, 33             ; '!'
    store-mem [v0 + 0], v1
    move-const v1, 13             ; '\r'
    store-mem [v0 + 0], v1
    move-const v1, 10             ; '\n'
    store-mem [v0 + 0], v1

    ; 4. Bare-metal park loop: Park CPU endlessly in J .
park_loop:
    goto park_loop

    move-const v2, 1
    return-val v2
.end_fn
